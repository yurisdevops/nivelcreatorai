# Copie para .dev.vars e preencha com o projeto Supabase separado deste produto.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, only for self-service account deletion. Keep this server-side; never use it in public/ files.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_LOCAL
# Opcional; padrão atual do projeto: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# Teto global diário e preço máximo por 1 milhão de tokens (USD).
AI_DAILY_BUDGET_USD=10
GEMINI_INPUT_USD_PER_MILLION=1.5
GEMINI_OUTPUT_USD_PER_MILLION=7.5
# Optional Asaas Sandbox credentials; never use a production key with this implementation.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Instagram API with Instagram Login (Meta professional account).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8787/auth/instagram/callback
META_GRAPH_API_VERSION=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
