# Copie para .dev.vars e preencha com o projeto Supabase separado deste produto.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxx
# Optional, only for self-service account deletion. Keep this server-side; never use it in public/ files.
SUPABASE_SECRET_KEY=
# Chave API do Google Cloud restrita ao Vertex AI GenerateContent. Mantenha-a só no .dev.vars.
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_VERTEX_LOCAL
GEMINI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=project-38cc0da1-19e8-40bf-9f6
GOOGLE_CLOUD_LOCATION=global
# Generate one random 32-byte secret and set it in both Workers.
FILE_SCANNER_SECRET=
# Roteador: tarefas simples usam Flash-Lite; roteiros/diagnósticos/planos usam o modelo complexo.
# GEMINI_MODEL permanece como fallback legado do modelo complexo.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_COMPLEX_MODEL=gemini-3.8-flash
# Troque modelo e tarifas juntos; confirme os preços atuais no painel do Gemini antes de produção.
GEMINI_SIMPLE_MODEL=gemini-3.5-flash-lite
GEMINI_SIMPLE_INPUT_USD_PER_MILLION=0.30
GEMINI_SIMPLE_OUTPUT_USD_PER_MILLION=2.50
# Tarifas conservadoras do modelo complexo (referência padrão do projeto).
GEMINI_INPUT_USD_PER_MILLION=1.5
GEMINI_OUTPUT_USD_PER_MILLION=7.5
# Teto global diário e preço máximo por 1 milhão de tokens (USD).
AI_DAILY_BUDGET_USD=3
# Optional Asaas Sandbox credentials; never use a production key with this implementation.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Instagram API with Instagram Login (Meta professional account).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8787/auth/instagram/callback
META_GRAPH_API_VERSION=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Cloudflare Email Service transactional sender; the sending domain must be onboarded first.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Nivel Creator AI
