{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nivel-creator-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nivel-creator",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nivel-creator-private"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026101501",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026101502",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
