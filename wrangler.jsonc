{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nivel-creator-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "routes": [
    { "pattern": "creator.nivelstudio.com.br", "custom_domain": true }
  ],
  "vars": {
    "GEMINI_PROVIDER": "gemini-api",
    "GOOGLE_CLOUD_PROJECT": "project-38cc0da1-19e8-40bf-9f6",
    "GOOGLE_CLOUD_LOCATION": "global",
    "DATA_RETENTION_ENABLED": "false",
    "BETA_INVITE_ONLY": "true",
    "AI_DAILY_BUDGET_USD": "3",
    "GEMINI_COMPLEX_MODEL": "gemini-3.8-flash",
    "GEMINI_SIMPLE_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_SIMPLE_INPUT_USD_PER_MILLION": "0.30",
    "GEMINI_SIMPLE_OUTPUT_USD_PER_MILLION": "2.50",
    "GEMINI_INPUT_USD_PER_MILLION": "1.5",
    "GEMINI_OUTPUT_USD_PER_MILLION": "7.5"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nivel-creator",
      "database_id": "1375cf14-8c76-4b02-97fb-02e73584c067",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nivel-creator-private"
    }
  ],
  // The FILE_SCANNER service binding returns when the ClamAV scanner Worker is
  // published. Without it, library uploads fail closed.
  "send_email": [
    { "name": "EMAIL" }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026101501",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026101502",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "MFA_RATE_LIMITER",
      "namespace_id": "2026101503",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/favicon.ico", "/kit/*", "/api/*", "/auth/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
