{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nivel-creator-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "vars": {
    "DATA_RETENTION_ENABLED": "false",
    "AI_DAILY_BUDGET_USD": "10",
    "GEMINI_INPUT_USD_PER_MILLION": "1.5",
    "GEMINI_OUTPUT_USD_PER_MILLION": "7.5"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nivel-creator",
      "database_id": "1375cf14-8c76-4b02-97fb-02e73584c067",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nivel-creator-private"
    }
  ],
  "services": [
    { "binding": "FILE_SCANNER", "service": "nivel-creator-file-scanner" }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "2026101501",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026101502",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "MFA_RATE_LIMITER",
      "namespace_id": "2026101503",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
